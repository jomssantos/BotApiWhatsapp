# copie para .env e preencha (o .env nunca vai pro GitHub)

# meta ou evolution
PROVIDER=meta
PORT=5000
LOG_LEVEL=INFO

# chave em https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
SYSTEM_PROMPT=Você é um assistente simpático e objetivo. Responda em português do Brasil.
MAX_HISTORY_MESSAGES=10

# Meta Cloud API
META_PERMANENT_TOKEN=
PHONE_NUMBER_ID=
BUSINESS_ID=
# texto inventado por você, igual ao do painel da Meta
VERIFY_TOKEN=troque-por-um-texto-secreto
# segredo do app, valida a assinatura dos webhooks
META_APP_SECRET=

# Evolution API
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=invente-uma-chave
INSTANCE_NAME=meu-bot

# lidas pelo container da Evolution
AUTHENTICATION_API_KEY=invente-uma-chave
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://postgres:sua-senha@evolution-postgres:5432/evolution
CACHE_REDIS_ENABLED=false
CACHE_LOCAL_ENABLED=true

# mesma senha da URI acima
POSTGRES_PASSWORD=sua-senha
